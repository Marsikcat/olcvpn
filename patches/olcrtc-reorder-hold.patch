+// A packet the SFU never forwards must not stall the stream: once
+// reorderMaxHold later packets are queued behind the hole, delivery resumes.
+func TestReorderBufferSkipsPermanentGap(t *testing.T) {
+	b := newReorderBuffer()
+	b.push(&rtp.Packet{Header: rtp.Header{SequenceNumber: 10}, Payload: []byte("a")})
+
+	// 11 is lost for good; 12.. keep arriving.
+	var delivered []uint16
+	for seq := uint16(12); seq < 12+reorderMaxHold+1; seq++ {
+		for _, p := range b.push(&rtp.Packet{Header: rtp.Header{SequenceNumber: seq}, Payload: []byte("x")}) {
+			delivered = append(delivered, p.SequenceNumber)
+		}
+	}
+	if len(delivered) != reorderMaxHold+1 || delivered[0] != 12 {
+		t.Fatalf("delivered = %v, want 12..%d after skipping the hole", delivered, 12+reorderMaxHold)
+	}
+
+	// The stream keeps flowing in order afterwards.
+	next := 12 + reorderMaxHold + 1
+	got := b.push(&rtp.Packet{Header: rtp.Header{SequenceNumber: uint16(next)}, Payload: []byte("y")})
+	if len(got) != 1 || got[0].SequenceNumber != uint16(next) {
+		t.Fatalf("post-gap push delivered %+v, want %d", got, next)
+	}
+}
