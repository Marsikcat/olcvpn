@@ -756,6 +756,18 @@ func (p *streamTransport) drainTrack(track *webrtc.TrackRemote) {
 
 const reorderWindow = 256
 
+// reorderMaxHold bounds how many later packets may queue up behind a missing
+// sequence number before the gap is given up on.
+//
+// The SFU no longer forwards a gap-free sequence: Telemost now leaves holes in
+// the numbering it rewrites for each subscriber, and those packets never
+// arrive. Waiting for the whole reorderWindow there meant ~256 packets of
+// stall per hole — about 25 s at the 10 pps keepalive rate — which outlasts
+// the handshake timeout and the liveness window, so no session could ever
+// form. Genuine reordering on this path spans a packet or two, and a dropped
+// frame is recovered by KCP retransmission anyway, so a short hold is enough.
+const reorderMaxHold = 4
+
 func seqLess(a, b uint16) bool {
 	return (a-b)&0x8000 != 0
 }
